@page "/pt"
@page "/en"
@inherits LocalizedComponent

<Seo Page="SitePage.Home" Title="@T("home.seo.title")" />

<section class="hero">
    <div class="wrap hero-inner">
        <img class="hero-egg" src="img/egg.svg" alt="" width="100" height="130" />
        <h1>@T("site.tagline")</h1>
        <p class="lead">@T("site.intro")</p>
        <div class="actions">
            <a class="button" href="@PathOf(SitePage.Games)">@T("home.cta.games")</a>
            <a class="button button-ghost" href="@PathOf(SitePage.About)">@T("home.cta.about")</a>
        </div>
    </div>
</section>

<div class="crack" aria-hidden="true"></div>

<section class="section section-shell" aria-labelledby="highlights">
    <div class="wrap">
        <h2 id="highlights">@T("home.highlights.title")</h2>
        <ul class="cards">
            @foreach (var key in Highlights)
            {
                <li class="card">
                    <h3>@T($"value.{key}.title")</h3>
                    <p>@T($"value.{key}.text")</p>
                </li>
            }
        </ul>
        <p class="more"><a href="@PathOf(SitePage.About)">@T("home.highlights.more")</a></p>
    </div>
</section>

<section class="section" aria-labelledby="current">
    <div class="wrap">
        <h2 id="current">@T("home.current.title")</h2>
        <SwanRaceCard />
    </div>
</section>

<section class="section section-shell" aria-labelledby="coffee">
    <div class="wrap narrow center">
        <h2 id="coffee">@T("cafe.title")</h2>
        <p>@T("home.cafe.text")</p>
        <a class="button" href="@PathOf(SitePage.Cafe)">@T("home.cafe.cta")</a>
    </div>
</section>

@code {
    private static readonly string[] Highlights = ["family", "noads", "fair", "offline"];
}
