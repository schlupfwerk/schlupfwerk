{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "never",
  "routes": [
    { "route": "/cafe", "rewrite": "/index.html" },
    { "route": "/pt", "rewrite": "/index.html" },
    { "route": "/pt/sobre", "rewrite": "/index.html" },
    { "route": "/pt/jogos", "rewrite": "/index.html" },
    { "route": "/pt/cafe", "rewrite": "/index.html" },
    { "route": "/pt/privacidade", "rewrite": "/index.html" },
    { "route": "/en", "rewrite": "/index.html" },
    { "route": "/en/about", "rewrite": "/index.html" },
    { "route": "/en/games", "rewrite": "/index.html" },
    { "route": "/en/cafe", "rewrite": "/index.html" },
    { "route": "/en/privacy", "rewrite": "/index.html" },
    {
      "route": "/_framework/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/fonts/v1/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' __INLINE_SCRIPT_HASHES__; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".dat": "application/octet-stream",
    ".webmanifest": "application/manifest+json",
    ".woff2": "font/woff2"
  }
}
